{
  "id": "voquangdengu",
  "name": "Vô Quang Đê Ngữ",
  "original_name": "无光低语",
  "item_type": "Vũ khí (Dao găm)",
  "base_rarity": 4,
  "max_stars": "Có thể thăng 6 sao",
