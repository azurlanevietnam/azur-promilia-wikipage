{
  "id": "khoangdalietduong",
  "name": "Khoáng Dã Liệt Dương",
  "original_name": "旷野烈阳",
  "item_type": "Vũ khí (Đại thái đao)",
  "base_rarity": 4,
  "max_stars": "Có thể thăng 6 sao",
