{
  "id": "hongluuchino",
  "name": "Hồng Lưu Chi Nộ",
  "original_name": "洪流之怒",
  "item_type": "Vũ khí (Búa chiến)",
  "base_rarity": 3,
  "max_stars": "Có thể thăng 3 sao",
