{
  "id": "battucdichviemquang",
  "name": "Bất Tức Đích Viêm Quang",
  "original_name": "不熄的炎光",
  "item_type": "Vũ khí (Song đao)",
  "base_rarity": 4,
  "max_stars": "Có thể thăng 6 sao",
