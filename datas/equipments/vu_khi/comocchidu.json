{
  "id": "comocchidu",
  "name": "Cổ Mộc Chi Dụ",
  "original_name": "古木之谕",
  "item_type": "Vũ khí (Sách phép)",
  "base_rarity": 4,
  "max_stars": "Có thể thăng 6 sao",
