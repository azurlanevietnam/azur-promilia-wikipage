{
  "id": "tandinhdoannhac",
  "name": "Tấn Đình Đoạn Nhạc",
  "original_name": "迅霆断岳",
  "item_type": "Vũ khí (Gậy phép)",
  "base_rarity": 4,
  "max_stars": "Có thể thăng 6 sao",
  "max_star_count": 6,
  "image": "../../../assets/equipment/tandinhdoannhac.png",
  "rarity_bg_image": "../../../assets/equipment/tandinhdoannhac_bg.png",
  "suit": "Không có bộ trang bị",
  "description": "Một cây gậy phép có thân đúc bằng vàng đen và bạc xanh, đường nét sắc sảo lạnh lùng, hoa văn tựa như dấu sét rạch ngang trời, đầu gậy nâng cao một cụm tinh thể nhọn màu tím sẫm, như thể ánh điện chớp đang ngưng tụ bên trong chờ bùng phát. Toàn thể khí thế nhanh nhẹn và cuồng bạo, dường như chỉ cần phát động là có thể dẫn sấm sét kinh hoàng từ chín tầng trời giáng thẳng xuống núi cao, trong chớp mắt khiến đá tan đỉnh lở.",
  "original_description": "一柄法杖，杖身以暗金与青银铸成，线条凌厉，纹饰如雷痕劈裂，杖首高举一暗紫尖锐晶簇，仿佛电光凝于其间而未发。整体气势迅疾而暴烈，似乎一经催动，便可引惊霆自九天直贯山岳，刹那间教石裂峰崩。",
  "acquisition_sources": [
    "Gia viên - Tiệm rèn",
    "Ủy thác - Biên Thùy Đầm Lầy V",
    "Ủy thác - Biên Thùy Đầm Lầy IV"
  ],
